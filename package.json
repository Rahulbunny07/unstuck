{
  "name": "unstuck",
  "version": "1.0.0",
  "description": "Paste an AI-builder error, get a fix backed by evidence, a copy-ready prompt, a check and a rollback.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test \"test/*.test.js\"",
    "eval": "node --env-file-if-exists=.env eval/run.js"
  },
  "engines": { "node": ">=22.13" },
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  }
}
