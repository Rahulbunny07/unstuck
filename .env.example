# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Free option: a Groq key (console.groq.com). Used when ANTHROPIC_API_KEY is empty.
GROQ_API_KEY=
# Check Groq's current model list; names change.
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_STRONG_MODEL=openai/gpt-oss-120b
# Cheap model for first attempts, stronger model for retries
FAST_MODEL=claude-haiku-5-5
STRONG_MODEL=claude-sonnet-5-5
PORT=3000
# Needed in production. Encrypts users' stored API keys and MCP tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
NODE_ENV=development
# Models used when a user brings their own OpenAI key
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_STRONG_MODEL=gpt-4o
# Optional shared AI for the whole site through a Pine Labs AgenticOrg agent
# (used only when ANTHROPIC_API_KEY is empty and a user has not added their own key)
AGENTICORG_API_KEY=
AGENTICORG_AGENT_ID=
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
# Dev only: allow MCP servers on localhost over http
ALLOW_LOCAL_MCP=0
# Daily limits on AI answers paid for by the site's key (UTC day). Known-error answers are free
# and people using their own key are not limited. Tokens are a stand-in for money: set the caps
# from your provider's real limits and prices.
# These values fit a FREE Groq key (about 200,000 tokens a day per model, 8,000 per minute,
# measured at about 1,100 to 1,900 tokens per answer). Raise them for a paid key.
DAILY_AI_LIMIT_ANON=4
DAILY_AI_LIMIT_USER=10
DAILY_AI_LIMIT_IP=150
GLOBAL_DAILY_AI_CALLS=150
GLOBAL_DAILY_AI_TOKENS=180000
# Payments: Razorpay (main). Key id and secret from Razorpay dashboard > Account & Settings > API Keys.
# rzp_test_ keys are test mode; rzp_live_ keys take real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when adding the webhook in Razorpay's dashboard
RAZORPAY_WEBHOOK_SECRET=
# Required for live (rzp_live_) keys. Set to 1 ONLY when the database is on permanent storage
# (a persistent disk or hosted database). Otherwise paid credits could be lost on a redeploy.
DB_PERSISTENT=0
# Payments: Pine Labs Online hosted checkout (optional fallback, used only if Razorpay is not set). Use the UAT (test) client id and secret from the
# Pine Labs dashboard (Settings > API Keys). Leave empty to switch buying credits off.
PINE_CLIENT_ID=
PINE_CLIENT_SECRET=
# UAT is the default. Production is https://api.pluralpay.in/api (from Pine Labs' n8n docs: confirm it in your dashboard).
PINE_BASE_URL=https://pluraluat.v2.pinepg.in/api
# The public address of this site, used for the return link Pine Labs sends customers back to.
PUBLIC_URL=http://localhost:3000
# Per-minute throttle for the site's AI key: requests over the minute's token budget wait in line.
# Default: 6500 for Groq (limit is 8,000 a minute), off for other providers. 0 turns it off.
THROTTLE_TOKENS_PER_MIN=6500
THROTTLE_MAX_WAIT_SECONDS=30
THROTTLE_MAX_QUEUE=40
# How much the Groq gpt-oss models think: low, medium, high, or default (provider's own setting)
GROQ_REASONING_EFFORT=low
# Set to 1 to switch the limits off (local testing only)
QUOTA_DISABLED=0
# Library hit threshold (0-1). Higher = stricter matching.
MATCH_THRESHOLD=0.85
# Votes needed before a fix is shown as "Verified by N people"
VERIFY_MIN_VOTES=2
